NODE_ENV=production
APP_ORIGIN=https://moodboard.example.com
PORT=3001
DATA_DIR=/var/lib/moodboard
SQLITE_PATH=/var/lib/moodboard/moodboard.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
MAGIC_LINK_TTL_MINUTES=20
COOKIE_SECURE=true

MAILGUN_API_KEY=key-your-mailgun-api-key
MAILGUN_DOMAIN=mg.example.com
MAILGUN_REGION=us
MAIL_FROM=Moodboard <hello@mg.example.com>

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
