[Unit]
Description=Moodboard web app
After=network.target

[Service]
Type=simple
# Current production deploy user is `james`.
# Change these if the app is moved to a different server/user.
User=james
Group=james
WorkingDirectory=/srv/moodboard/current
EnvironmentFile=/etc/moodboard.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
